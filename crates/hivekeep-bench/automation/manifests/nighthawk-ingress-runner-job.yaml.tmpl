# The runner Job of a `type: nighthawk-ingress` entry. orchestrator.py fills
# the placeholders (see job_subs in testtypes/nighthawk_ingress.py).
# Namespace, identity and labels match runner-job.yaml.tmpl.

apiVersion: v1
kind: Namespace
metadata:
  name: benchmarking
  labels:
    # hivekeep-system admits API clients only from namespaces with this label.
    hivekeep.io/api-access: "true"
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: benchmark-runner
  namespace: benchmarking
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: benchmark-runner-endpointslices
  namespace: hivekeep-system
subjects:
- kind: ServiceAccount
  name: benchmark-runner
  namespace: benchmarking
roleRef:
  kind: Role
  name: keeper-endpointslices
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: batch/v1
kind: Job
metadata:
  name: ${JOB_NAME}
  namespace: benchmarking
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app: hivekeep-benchmark-runner
        test-name: ${NAME}
        tag: ${TAG}
    spec:
      restartPolicy: Never
      serviceAccountName: benchmark-runner
      tolerations:
      - key: hivekeep.io/benchmarking
        operator: Equal
        value: "true"
        effect: NoSchedule
      containers:
      - name: runner
        image: ${IMAGE}
        imagePullPolicy: IfNotPresent
        command:
        - "python3"
        - "/app/runner.py"
        args:
        - "--name"
        - "${NAME}"
        - "--tag"
        - "${TAG}"
        - "--dest"
        - "${DEST}"
        - "--envoy-cpu"
        - "${ENVOY_CPU}"
        - "--actors"
        - "${ACTORS}"
        - "--hive"
        - "${HIVE}"
        - "--client-concurrency"
        - "${CLIENT_CONCURRENCY}"
        - "--connections"
        - "${CONNECTIONS}"
        - "--max-pending"
        - "${MAX_PENDING}"
        - "--initial-rps"
        - "${INITIAL_RPS}"
        - "--exp-factor"
        - "${EXP_FACTOR}"
        - "--measuring-period"
        - "${MEASURING_PERIOD}"
        - "--convergence-deadline"
        - "${CONVERGENCE_DEADLINE}"
        - "--testing-stage-duration"
        - "${TESTING_STAGE_DURATION}"
        - "--success-rate-threshold"
        - "${SUCCESS_RATE}"
        - "--send-rate-threshold"
        - "${SEND_RATE}"
        - "--tail-latency-slo-ms"
        - "${TAIL_LATENCY_SLO_MS}"
        env:
        - name: HK_API_CLIENT_AUTH
          value: "${API_CLIENT_AUTH}"
        volumeMounts:
        - name: servicedns
          mountPath: /run/servicedns.podcert.hivekeep.io
          readOnly: true
        - name: api-token
          mountPath: /run/hivekeep-api-token
          readOnly: true
        - name: podidentity
          mountPath: /run/podidentity.podcert.hivekeep.io
          readOnly: true
        # One core per event loop plus one for the runner, and no CPU limit,
        # so open-loop pacing is never throttled.
        resources:
          requests:
            cpu: "${RUNNER_CPU}"
            memory: "1Gi"
      volumes:
      - name: servicedns
        projected:
          sources:
          - clusterTrustBundle:
              signerName: servicedns.podcert.hivekeep.io/identity
              labelSelector:
                matchLabels:
                  podcert.hivekeep.io/canarying: live
              path: trust-bundle.pem
      - name: api-token
        projected:
          sources:
          - serviceAccountToken:
              audience: hivekeep-api.hivekeep-system.svc
              expirationSeconds: 3600
              path: token
      - name: podidentity
        projected:
          sources:
          - podCertificate:
              signerName: podidentity.podcert.hivekeep.io/identity
              keyType: ECDSAP256
              credentialBundlePath: credential-bundle.pem
