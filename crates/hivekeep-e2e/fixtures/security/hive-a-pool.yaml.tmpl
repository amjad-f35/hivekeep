# Hive A of the cross-hive security fixture: a namespace plus the only
# WorkerPool. Hive B deploys hive-b-namespace.yaml.tmpl, a namespace
# with no pool, so its actors run on this one too.
#
# replicas is 1 on purpose. Pools are not scoped to an hive: the scheduler
# matches on sandbox class, labels and capacity, never on the actor's
# hive. The test runs the victim, suspends it, then starts the attacker.
# With one worker the attacker has to land on the worker the victim just
# left, which is where the victim's per-actor host state is. With more
# workers the attacker could boot on a fresh one and the host-state checks
# would prove nothing.
#
# The workload label is a fixed string rather than ${FIXTURE_SUFFIX}-suffixed
# because both hives' templates must select this one pool and they render
# with different suffixes. Sharing the label across the gVisor and micro-VM
# lanes is safe: they run one after the other, and sandbox class is itself a
# scheduling constraint.

apiVersion: v1
kind: Namespace
metadata:
  name: hivekeep-e2e${FIXTURE_SUFFIX}

---

apiVersion: hivekeep.io/v1
kind: WorkerPool
metadata:
  name: shared
  namespace: hivekeep-e2e${FIXTURE_SUFFIX}
  labels:
    workload: hivekeep-e2e-security
spec:
  replicas: 1
  workerImage: ${WORKER_IMAGE}
${WORKERPOOL_RUNTIME}
