# The probe fixture's ActorTemplate: a protojson-shaped hivekeep.api.v1.ActorTemplate
# (NOT the hivekeep.io/v1 CRD), created through the Hivekeep API by
# the e2e harness after it fills in the probe image. The
# hivekeep-e2e-probe${FIXTURE_SUFFIX} hive doubles as the pool's k8s namespace
# name in probe.yaml.tmpl.

metadata:
  hive: hivekeep-e2e-probe${FIXTURE_SUFFIX}
  name: probe
workerSelector:
  matchLabels:
    workload: probe${FIXTURE_SUFFIX}
containers:
- name: probe
  image: ${PROBE_IMAGE}
  volumeMounts:
  # the probe reads actor metadata and trust bundles under /run/hivekeep
  - name: system-info
    mountPath: /run/hivekeep
  # The probe binary binds :80 immediately, so this gates actor start on a
  # readiness signal rather than a guess, and carries a non-default
  # timeoutSeconds so e2e covers the value crossing hivekeep-api -> keeper -> worker
  # instead of only the worker's built-in default.
  wakeupProbe:
    httpGet:
      path: /healthz
      port: 80
    timeoutSeconds: 60
volumes:
- name: system-info
  systemInfo:
    dataSources:
    - actorMetadata:
        items:
        - field: ACTOR_METADATA_FIELD_NAME
          path: actor-id
        - field: ACTOR_METADATA_FIELD_HIVE
          path: hive
        - field: ACTOR_METADATA_FIELD_UID
          path: actor-uid
    # Only for suites that ask for the trust bundle: the bundle is a cluster
    # singleton, so a suite that merely needs a probe must not depend on it.
${TEMPLATE_TRUST_BUNDLE}
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912 # 512Mi
snapshotConfig:
  storageLocation: gs://${BUCKET_NAME}/hivekeep-e2e-probe${FIXTURE_SUFFIX}/
