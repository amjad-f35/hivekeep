{
  "displayName": "Hivekeep Routing & E2E Latency",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Hivekeep routing latency — P50/P95/P99",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.50, sum by (le) (rate({\"hivekeep.gate.router.route.duration_bucket\", top_level_controller_name=\"gate-router\"}[5m])))",
                  "unitOverride": "s"
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "P50"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le) (rate({\"hivekeep.gate.router.route.duration_bucket\", top_level_controller_name=\"gate-router\"}[5m])))",
                  "unitOverride": "s"
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "P95"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (le) (rate({\"hivekeep.gate.router.route.duration_bucket\", top_level_controller_name=\"gate-router\"}[5m])))",
                  "unitOverride": "s"
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "P99"
              }
            ],
            "yAxis": {
              "label": "seconds",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Hivekeep routing latency P99 - by stages",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (le) (rate({\"hivekeep.gate.router.route.duration_bucket\", top_level_controller_name=\"gate-router\"}[5m])))",
                  "unitOverride": "s"
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "hivekeep routing P99"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (le) (rate({\"rpc.server.call.duration_bucket\", top_level_controller_name=\"hivekeep-api\", \"rpc.method\"=\"hivekeep.api.v1.Control/ResumeActor\"}[5m])))",
                  "unitOverride": "s"
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "hivekeep-api ResumeActor P99"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (le) (rate({\"rpc.server.call.duration_bucket\", top_level_controller_name=\"keeper\", \"rpc.method\"=\"hivekeep.keeper.v1.Keeper/Restore\"}[5m])))",
                  "unitOverride": "s"
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "keeper Restore P99"
              }
            ],
            "yAxis": {
              "label": "seconds",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Hivekeep routing latency P99 — by ActorTemplate",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (le, \"hk.template.name\") (rate({\"hivekeep.gate.router.route.duration_bucket\", top_level_controller_name=\"gate-router\", \"hk.router.outcome\"=\"ok\"}[5m])))",
                  "unitOverride": "s"
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "seconds",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Hivekeep routing QPS - by Status",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (\"hk.router.outcome\") (rate({\"hivekeep.gate.router.route.duration_count\", top_level_controller_name=\"gate-router\"}[5m]))",
                  "unitOverride": "1/s"
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "requests/s",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Hivekeep E2E (full round-trip) Latency — P50/P95/P99",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.50, sum by (le) (rate(envoy_http_downstream_rq_time_bucket{envoy_http_conn_manager_prefix=~\"ingress_.*\"}[5m])))",
                  "unitOverride": "ms"
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "P50 (all ingress)"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le) (rate(envoy_http_downstream_rq_time_bucket{envoy_http_conn_manager_prefix=~\"ingress_.*\"}[5m])))",
                  "unitOverride": "ms"
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "P95 (all ingress)"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (le) (rate(envoy_http_downstream_rq_time_bucket{envoy_http_conn_manager_prefix=~\"ingress_.*\"}[5m])))",
                  "unitOverride": "ms"
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "P99 (all ingress)"
              }
            ],
            "yAxis": {
              "label": "milliseconds",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Hivekeep E2E (full round-trip) QPS — by Response Code",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (envoy_response_code_class) (rate(envoy_http_downstream_rq_xx{envoy_http_conn_manager_prefix=~\"ingress_.*\"}[5m]))",
                  "unitOverride": "1/s"
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "${metric.labels.envoy_response_code_class}xx"
              }
            ],
            "yAxis": {
              "label": "requests/s",
              "scale": "LINEAR"
            }
          }
        }
      }
    ]
  }
}
