# ActorTemplate (protojson-shaped hivekeep.api.v1.ActorTemplate) for the sandbox
# demo. Applied with `hivectl create actor-template -f -` after
# the installer pins the image reference; the hivekeep-demo-sandbox
# hive must exist.
metadata:
  hive: hivekeep-demo-sandbox
  name: sandbox-template
workerSelector:
  matchLabels:
    workload: sandbox
containers:
- name: sandbox
  image: REGISTRY_PLACEHOLDER/hivekeep-demo-sandbox:0.1.0
  env:
  - name: PORT
    value: "80"
# Sandbox size: an actor occupies its whole worker, so size it at (or below)
# the pool's per-worker capacity (see sandbox.yaml.tmpl and the workers' sizing modules).
resources:
  limits:
    cpuMillicores: 2000
    memoryBytes: 1073741824 # 1Gi
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
  storageLocation: gs://${BUCKET_NAME}/hivekeep-demo-sandbox/
