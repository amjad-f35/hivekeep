# ActorTemplate (protojson-shaped hivekeep.api.v1.ActorTemplate) for the luna agent
# of the claude-code-multiplex demo; one of three agents sharing the 2-pod
# pool in claude-code-multiplex.yaml.tmpl. Applied with
# `hivectl create actor-template -f -`; the claude-multiplex-demo
# hive must exist.
#
# ANTHROPIC_API_KEY is substituted into the container env as a plain value
# at apply time. WORKLOAD_IMAGE is the resolved sha256-digest reference for
# the claude-multiplex-demo-workload image — built and pushed to
# ${HK_BUILD_REPO} by the deploy step, substituted at apply time.
metadata:
  hive: claude-multiplex-demo
  name: agent-luna
workerSelector:
  matchLabels:
    workload: claude-multiplex
containers:
- name: claude
  image: ${WORKLOAD_IMAGE}
  env:
  - name: ACTOR_NAME
    value: "luna"
  - name: TASK
    value: "Tell me one short, surprising fact about the Moon. One sentence."
  - name: INTERVAL_SECONDS
    value: "45"
  - name: ANTHROPIC_API_KEY
    value: "${ANTHROPIC_API_KEY}"
# Sandbox size: Claude Code on Node uses several hundred MB and spikes while
# running tools.
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 2147483648 # 2Gi
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
  storageLocation: gs://${BUCKET_NAME}/claude-multiplex-demo/
