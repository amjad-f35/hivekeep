# ActorTemplate (protojson-shaped hivekeep.api.v1.ActorTemplate) for the mars agent
# of the claude-code-multiplex demo; see agent-luna-template.yaml.tmpl for
# the placeholder and apply conventions.
metadata:
  hive: claude-multiplex-demo
  name: agent-mars
workerSelector:
  matchLabels:
    workload: claude-multiplex
containers:
- name: claude
  image: ${WORKLOAD_IMAGE}
  env:
  - name: ACTOR_NAME
    value: "mars"
  - name: TASK
    value: "Give me one concise tip for learning a new programming language. One sentence."
  - name: INTERVAL_SECONDS
    value: "45"
  - name: ANTHROPIC_API_KEY
    value: "${ANTHROPIC_API_KEY}"
# Sandbox size: see agent-luna-template.yaml.tmpl.
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 2147483648 # 2Gi
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
  storageLocation: gs://${BUCKET_NAME}/claude-multiplex-demo/
