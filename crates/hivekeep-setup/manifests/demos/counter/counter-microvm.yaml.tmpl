# Worker pool for the micro-VM (kata + cloud-hypervisor) variant of the
# counter demo. The counter is in-RAM (atomic uint64), so a successful
# suspend/resume across pods shows the count continuing — proving the guest
# memory snapshot round-tripped. The ActorTemplate is not a CRD: it lives in
# counter-microvm-template.yaml.tmpl and is created through the hivekeep API with
# `hivectl create actor-template`. The cluster-wide `microvm`
# SandboxConfig referenced by the pool is installed by
# scripts/install-microvm-deps.sh

apiVersion: v1
kind: Namespace
metadata:
  name: hivekeep-demo-counter-microvm

---

apiVersion: hivekeep.io/v1
kind: WorkerPool
metadata:
  name: counter-microvm
  namespace: hivekeep-demo-counter-microvm
  labels:
    workload: counter-microvm
spec:
  # Two workers: one for the demo actor, one spare for the golden actor the
  # template reconciler runs while building the golden snapshot.
  replicas: 2
  sandboxClasses:
  - name: microvm
    configRef:
      name: microvm
  workerImage: REGISTRY_PLACEHOLDER/hivekeep-sandbox-microvm:0.1.0
  template:
    # Per-worker resources: these size the worker POD and advertise its
    # scheduling capacity (the per-actor ceiling). The micro-VM sandbox itself is
    # sized by the ActorTemplate's resources in counter-microvm-template.yaml.tmpl,
    # not by these. The worker keeps some of this limit for itself, and each
    # actor books its limit plus the microVM overhead, so keep this limit
    # above what the actors need together (see docs/api-guide.md).
    #
    # Capacity comes from the limits (workerCapacity reads limits only), while the
    # kube-scheduler packs nodes by the requests — so the CPU request is set well
    # below the limit to keep the pool placeable on a small node (a single kind
    # node in CI, shared with the gVisor demo pool) without changing what an actor
    # is allowed to use. Memory is not compressible, so its request matches the
    # limit: the guest RAM plus its overhead has to be really there.
    resources:
      limits:
        cpu: "1"
        memory: 1Gi
      requests:
        cpu: 250m
        memory: 1Gi
