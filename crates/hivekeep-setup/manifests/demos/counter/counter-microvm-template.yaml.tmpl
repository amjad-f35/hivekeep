# ActorTemplate (protojson-shaped hivekeep.api.v1.ActorTemplate) for the micro-VM
# counter demo. Applied with `hivectl create actor-template -f -` after
# the installer pins the image reference; the
# hivekeep-demo-counter-microvm hive must exist.
metadata:
  hive: hivekeep-demo-counter-microvm
  name: counter-microvm
workerSelector:
  matchLabels:
    workload: counter-microvm
containers:
- name: counter
  image: REGISTRY_PLACEHOLDER/hivekeep-demo-counter:0.1.0
  command:
  - /app/counter
  # Exercises gate-router's arbitrary-port ingress support: a second
  # listener a test can address by CONNECTing to <actor-dns>:9090, distinct
  # from the primary port 80 every other assertion in this demo uses. Kept
  # in step with counter-template.yaml.tmpl — the networking suite runs
  # against whichever of the two the sandbox class under test selects.
  - --extra-port=9090
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
    # Well above the 30s default hivekeep-api applies when timeoutSeconds is unset,
    # which the gVisor counter is happy with. A micro-VM actor answers in a
    # few seconds on an idle node, but CI runs every suite against this one
    # pool on a single kind node and a guest boot stretches badly under that
    # contention.
    timeoutSeconds: 120
  # The counter writes its file counter here. With the durableDir volume
  # below it lands on a host-backed virtio-fs share instead of the guest-RAM
  # rootfs upper, so it survives a VOLUMES snapshot (which keeps neither guest
  # memory nor rootfs writes).
  volumeMounts:
  - name: data
    mountPath: /home/counter
# Sandbox size: vCPUs + guest RAM, which with the microVM overhead has to
# fit the pool's per-worker capacity (see docs/api-guide.md).
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912 # 512Mi
snapshotConfig:
  # MEMORY, matching the gVisor variant: a suspend captures guest memory, so
  # the in-RAM count continues from where it left off — the round-trip this
  # demo promises. ROOTFS is also available on this class: it would keep the
  # file counter and any rootfs writes but cold-boot the memory counter.
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
  storageLocation: gs://${BUCKET_NAME}/hivekeep-demo-counter-microvm/
volumes:
- name: data
  durableDir: {}
