# ActorTemplate (protojson-shaped hivekeep.api.v1.ActorTemplate) for the counter
# demo. Applied with `hivectl create actor-template -f -` after
# the installer pins the image reference; the hivekeep-demo-counter
# hive must exist.
#
# The ${...}_ARG/MOUNTS/VOLUMES placeholder lines are dropped on a plain
# deploy and filled in by --deploy-demo-counter-with-external-volume.
metadata:
  hive: hivekeep-demo-counter
  name: counter
workerSelector:
  matchLabels:
    workload: counter
containers:
- name: counter
  image: REGISTRY_PLACEHOLDER/hivekeep-demo-counter:0.1.0
  command:
  - /app/counter
  # Exercises gate-router's arbitrary-port ingress support: a second
  # listener a test can address by CONNECTing to <actor-dns>:9090, distinct
  # from the primary port 80 every other assertion in this demo uses.
  - --extra-port=9090
  - --tcp-port=9091
${VALIDATE_EXISTING_FILE_PATH_ARG}
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
  volumeMounts:
  - name: data
    mountPath: /home/counter
${EXTERNAL_VOLUME_MOUNTS}
# Sandbox size: an actor occupies its whole worker, so size it at (or below)
# the pool's per-worker capacity (see counter.yaml.tmpl and the workers' sizing modules).
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912 # 512Mi
snapshotConfig:
  # MEMORY, so a suspend captures process memory as well as the durable
  # volumes and the tutorial's in-memory counter really does continue
  # across suspend/resume. VOLUMES behavior (durable volumes only,
  # memory cold-boots) is exercised by the e2e demo suite's own
  # parameterized templates, not by this one.
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
  storageLocation: gs://${BUCKET_NAME}/hivekeep-demo-counter/
volumes:
- name: data
  durableDir: {}
${EXTERNAL_VOLUMES}
