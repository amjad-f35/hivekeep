# Hivekeep ActorTemplate resource (protojson-shaped hivekeep.api.v1.ActorTemplate,
# NOT the hivekeep.io/v1 CRD) for the micro-VM egress demo. The actor's
# outbound TCP is redirected into the worker tunnel by nftables in the worker
# (prepareActorEgress), which the micro-VM worker implements the same way the
# gVisor one does — this fixture is what proves it end to end. Delivery of the
# projected trust bundle into the sandbox also differs by class — a read-only
# bind for gVisor, the unified virtio-fs share for the guest here — so the
# projection is proven on both.
#
# Kept in step with egress-template.yaml.tmpl; the deltas are the
# runtime fields and the sandbox size.

metadata:
  hive: hivekeep-demo-egress-microvm
  name: egress-microvm
workerSelector:
  matchLabels:
    workload: egress-microvm
containers:
- name: egress
  image: REGISTRY_PLACEHOLDER/hivekeep-demo-egress:0.1.0
  command: ["/app/egress"]
  # SSL_CERT_FILE adds the gateway CA. The demo binary also keeps the
  # image's public roots from /etc/ssl/certs, so tls_passthrough origins
  # still verify; SSL_CERT_DIR is not needed and is left unset.
  env:
  - name: SSL_CERT_FILE
    value: /run/hivekeep/trust-bundle.pem
  volumeMounts:
  # the bundle lands at /run/hivekeep/trust-bundle.pem
  - name: system-info
    mountPath: /run/hivekeep
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
    # See ../counter/counter-microvm-template.yaml.tmpl: a micro-VM guest needs
    # more than the wakeup probe's 30s default once CI's single kind node is under load.
    timeoutSeconds: 120
volumes:
- name: system-info
  systemInfo:
    dataSources:
    # The trust anchors for the per-SNI leaves the egress gateway mints.
    # Only allowlisted bundle names resolve; this is the one supported today.
    - trustBundle:
        names:
        - egress-mitm.hivekeep.io
        path: trust-bundle.pem
# Sandbox size: worker applies these to the VM (see the workers' sizing modules).
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912 # 512Mi
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
  storageLocation: gs://${BUCKET_NAME}/hivekeep-demo-egress-microvm/
