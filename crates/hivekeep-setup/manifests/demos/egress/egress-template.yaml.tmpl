# Hivekeep ActorTemplate resource (protojson-shaped hivekeep.api.v1.ActorTemplate,
# NOT the hivekeep.io/v1 CRD) for the egress demo. Applied with
# `hivectl create actor-template -f -` after the installer pins the image
# reference; the hivekeep-demo-egress hive must exist.
#
# The actor also trusts the egress gateway CA: the gateway terminates the TLS
# its `https` rules allow and mints the per-SNI leaf the actor sees, which
# chains to no public CA. The networking e2e suite builds its egress actors
# from this fixture.

metadata:
  hive: hivekeep-demo-egress
  name: egress
workerSelector:
  matchLabels:
    workload: egress
containers:
- name: egress
  image: REGISTRY_PLACEHOLDER/hivekeep-demo-egress:0.1.0
  command: ["/app/egress"]
  env:
  - name: SSL_CERT_DIR
    value: /run/hivekeep/egress-trust-bundle/
  volumeMounts:
  - name: system-info
    mountPath: /run/hivekeep
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
volumes:
- name: system-info
  systemInfo:
    dataSources:
    # The trust anchors for the per-SNI leaves the egress gateway mints.
    # Only allowlisted bundle names resolve; this is the one supported today.
    - trustBundle:
        names:
        - egress-mitm.hivekeep.io
        - system-roots.hivekeep.io
        path: egress-trust-bundle/trust-bundle.pem
# Sandbox size. The pool sets no worker limits, so the worker offers the
# node's allocatable and these only need to fit the node.
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912 # 512Mi
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
  storageLocation: gs://${BUCKET_NAME}/hivekeep-demo-egress/
