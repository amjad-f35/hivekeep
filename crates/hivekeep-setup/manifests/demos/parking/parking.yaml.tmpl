# This demo exercises request parking in the gate router. The WorkerPool is
# deliberately small (2 workers) so that creating and requesting more than two
# actors at once oversubscribes the pool. When AssignWorker finds no worker with
# room it returns ResourceExhausted ("no worker has room for the actor"); with
# parking enabled (the default) the router holds such requests and retries the
# resume until a worker frees up (e.g. another actor suspends), instead of
# failing fast with 503. The workload is the same counter binary used by the
# counter demo -- its reply includes the worker pod IP, so you can see which
# worker served a (possibly parked) request.
#
# The ActorTemplate is not a CRD: it lives in parking-template.yaml.tmpl and
# is created through the hivekeep API with `hivectl create actor-template`.

apiVersion: v1
kind: Namespace
metadata:
  name: hivekeep-demo-parking

---

apiVersion: hivekeep.io/v1
kind: WorkerPool
metadata:
  name: parking
  namespace: hivekeep-demo-parking
  labels:
    workload: parking
spec:
  # Intentionally small: 2 workers, so 3+ concurrently-active actors saturate
  # the pool and exercise the parking path.
  replicas: 2
  workerImage: REGISTRY_PLACEHOLDER/hivekeep-sandbox-gvisor:0.1.0
  sandboxClasses:
  - name: gvisor
