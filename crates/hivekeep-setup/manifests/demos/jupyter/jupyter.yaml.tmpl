kind: WorkerPool
metadata:
  name: jupyter
  namespace: hivekeep-demo-jupyter
  labels:
    workload: jupyter
spec:
  replicas: 1
  workerImage: REGISTRY_PLACEHOLDER/hivekeep-sandbox-gvisor:0.1.0
  sandboxClasses:
  - name: gvisor
